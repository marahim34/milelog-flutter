"<!DOCTYPE html>\n<html lang=\"en\"><head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>MileLog — Trip details + Edit<\u002Ftitle>\n  <style>/* MileLog — global tokens + base */\n/* cyrillic-ext */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"0e97d64a-bb6a-426b-b857-887fd85d1172\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* cyrillic */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"84cd79dd-12b2-4fea-be6e-fe50425496ef\") format('woff2');\n  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;\n}\n/* greek */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"7eeaba78-7a6d-4a30-b7cf-b542560a1501\") format('woff2');\n  unicode-range: U+0370-0377, U+037A-037F, U+0384-038A, U+038C, U+038E-03A1, U+03A3-03FF;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"06a675cf-0228-4666-b4ed-e6046fc13ba2\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"178ce02e-2d9c-48c0-b23a-d1df82f7991f\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"c934fcfb-1c23-4768-a57b-6399104cd42a\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* cyrillic-ext */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"0e97d64a-bb6a-426b-b857-887fd85d1172\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* cyrillic */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"84cd79dd-12b2-4fea-be6e-fe50425496ef\") format('woff2');\n  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;\n}\n/* greek */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"7eeaba78-7a6d-4a30-b7cf-b542560a1501\") format('woff2');\n  unicode-range: U+0370-0377, U+037A-037F, U+0384-038A, U+038C, U+038E-03A1, U+03A3-03FF;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"06a675cf-0228-4666-b4ed-e6046fc13ba2\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"178ce02e-2d9c-48c0-b23a-d1df82f7991f\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'JetBrains Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"c934fcfb-1c23-4768-a57b-6399104cd42a\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Space Grotesk';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"a5d7e355-c5a7-4039-b8ab-f15e1812bf0e\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Space Grotesk';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"9608e18c-a538-42ac-862e-40ce6f0ce0d8\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Space Grotesk';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"e0030985-3cf0-4b29-8d94-e5b929e64775\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Space Grotesk';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"a5d7e355-c5a7-4039-b8ab-f15e1812bf0e\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Space Grotesk';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"9608e18c-a538-42ac-862e-40ce6f0ce0d8\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Space Grotesk';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"e0030985-3cf0-4b29-8d94-e5b929e64775\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Space Grotesk';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"a5d7e355-c5a7-4039-b8ab-f15e1812bf0e\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Space Grotesk';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"9608e18c-a538-42ac-862e-40ce6f0ce0d8\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Space Grotesk';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"e0030985-3cf0-4b29-8d94-e5b929e64775\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Space Grotesk';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"a5d7e355-c5a7-4039-b8ab-f15e1812bf0e\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Space Grotesk';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"9608e18c-a538-42ac-862e-40ce6f0ce0d8\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Space Grotesk';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"e0030985-3cf0-4b29-8d94-e5b929e64775\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n\n\n/* 3 palettes switchable via [data-palette] on :root */\n:root {\n  /* Dark · Magenta (default) */\n  --bg: #140910;\n  --bg-elev: #1F1018;\n  --bg-elev-2: #2A1722;\n  --bg-inset: #0B0508;\n  --border: #2E1A25;\n  --border-strong: #3F2433;\n  --fg: #F6EEF3;\n  --fg-dim: #B8A0AE;\n  --fg-dimmer: #816A78;\n  --fg-ghost: #4A3742;\n  --accent: oklch(0.72 0.19 5);\n  --accent-2: oklch(0.78 0.15 45);\n  --accent-tint: oklch(0.72 0.19 5 / 0.14);\n  --accent-ink: #15080E;\n  --success: oklch(0.78 0.16 150);\n  --danger: oklch(0.68 0.22 25);\n  --warning: oklch(0.82 0.16 85);\n  --biz: oklch(0.72 0.19 5);\n  --personal: oklch(0.78 0.15 250);\n}\n\n:root[data-palette='lime'] {\n  --bg: #0A0F0A;\n  --bg-elev: #121913;\n  --bg-elev-2: #1A231C;\n  --bg-inset: #050805;\n  --border: #1F2A20;\n  --border-strong: #2A3A2C;\n  --fg: #EEF4EE;\n  --fg-dim: #9FB3A2;\n  --fg-dimmer: #6E8172;\n  --fg-ghost: #3F4E42;\n  --accent: oklch(0.9 0.22 125);\n  --accent-2: oklch(0.76 0.16 155);\n  --accent-tint: oklch(0.9 0.22 125 / 0.14);\n  --accent-ink: #0A0F0A;\n  --success: oklch(0.82 0.18 150);\n  --danger: oklch(0.7 0.22 25);\n  --warning: oklch(0.82 0.16 85);\n  --biz: oklch(0.9 0.22 125);\n  --personal: oklch(0.72 0.12 280);\n}\n\n:root[data-palette='cyan'] {\n  --bg: #06101D;\n  --bg-elev: #0D1A2A;\n  --bg-elev-2: #13233A;\n  --bg-inset: #030814;\n  --border: #1A2D45;\n  --border-strong: #254060;\n  --fg: #EBF2FA;\n  --fg-dim: #94AAC1;\n  --fg-dimmer: #60788F;\n  --fg-ghost: #35465A;\n  --accent: oklch(0.82 0.15 185);\n  --accent-2: oklch(0.76 0.12 220);\n  --accent-tint: oklch(0.82 0.15 185 / 0.14);\n  --accent-ink: #05101C;\n  --success: oklch(0.82 0.15 165);\n  --danger: oklch(0.68 0.22 25);\n  --warning: oklch(0.82 0.16 85);\n  --biz: oklch(0.82 0.15 185);\n  --personal: oklch(0.78 0.14 300);\n}\n\n:root[data-theme='light'] {\n  --bg: #FBF6F5;\n  --bg-elev: #FFFFFF;\n  --bg-elev-2: #FDF9F8;\n  --bg-inset: #F2E9E6;\n  --border: #EADDD8;\n  --border-strong: #D8C4BC;\n  --fg: #1C0E14;\n  --fg-dim: #6B5460;\n  --fg-dimmer: #9E8392;\n  --fg-ghost: #D2BFC9;\n  --accent: oklch(0.58 0.22 5);\n  --accent-2: oklch(0.66 0.18 45);\n  --accent-tint: oklch(0.58 0.22 5 / 0.1);\n  --accent-ink: #FFFFFF;\n  --success: oklch(0.58 0.15 150);\n  --danger: oklch(0.58 0.22 25);\n  --biz: oklch(0.58 0.22 5);\n  --personal: oklch(0.62 0.16 250);\n}\n:root[data-theme='light'][data-palette='lime'] {\n  --bg: #F7FAF5; --bg-elev:#FFFFFF; --bg-inset:#ECF2E7; --border:#DAE6D2; --border-strong:#BFD0B3;\n  --fg:#0E140F; --fg-dim:#5A6B5E; --fg-dimmer:#8A9D8E;\n  --accent: oklch(0.55 0.2 135); --accent-tint: oklch(0.55 0.2 135 / 0.12); --accent-ink:#fff;\n  --biz: oklch(0.55 0.2 135); --personal: oklch(0.58 0.14 280);\n}\n:root[data-theme='light'][data-palette='cyan'] {\n  --bg: #F2F7FA; --bg-elev:#FFFFFF; --bg-inset:#E3EEF4; --border:#D0E0EA; --border-strong:#A9C3D4;\n  --fg:#081521; --fg-dim:#52687A; --fg-dimmer:#8099AD;\n  --accent: oklch(0.58 0.13 205); --accent-tint: oklch(0.58 0.13 205 / 0.12); --accent-ink:#fff;\n  --biz: oklch(0.58 0.13 205); --personal: oklch(0.6 0.14 300);\n}\n\n* { box-sizing: border-box; }\n\nhtml, body {\n  margin: 0;\n  padding: 0;\n  font-family: 'Space Grotesk', system-ui, sans-serif;\n  background: #1a1d24;\n  color: var(--fg);\n  min-height: 100vh;\n  overflow-x: hidden;\n  -webkit-font-smoothing: antialiased;\n}\n\nbody {\n  background:\n    radial-gradient(circle at 20% 10%, #22262f 0%, transparent 45%),\n    radial-gradient(circle at 80% 90%, #1d2028 0%, transparent 50%),\n    #14161c;\n}\n\n.mono { font-family: 'JetBrains Mono', monospace; }\n.tnum { font-variant-numeric: tabular-nums; font-feature-settings: 'tnum'; }\n\n/* Stage — scrollable device area */\n.stage {\n  min-height: 100vh;\n  display: flex;\n  align-items: flex-start;\n  justify-content: center;\n  padding: 40px 20px 80px;\n  gap: 48px;\n  flex-wrap: wrap;\n}\n\n.stage-label {\n  font-size: 11px;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  color: #8a92a1;\n  font-family: 'JetBrains Mono', monospace;\n  margin-bottom: 14px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.stage-label::before {\n  content: '';\n  width: 6px; height: 6px;\n  border-radius: 50%;\n  background: #8a92a1;\n  opacity: 0.6;\n}\n\n.device-wrap {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n}\n\n/* Screen inside device — takes over the device's surface */\n.screen {\n  background: var(--bg);\n  color: var(--fg);\n  width: 100%;\n  height: 100%;\n  overflow-y: auto;\n  overflow-x: hidden;\n  font-family: 'Space Grotesk', system-ui, sans-serif;\n  scrollbar-width: thin;\n  scrollbar-color: var(--border-strong) transparent;\n}\n.screen::-webkit-scrollbar { width: 4px; }\n.screen::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 2px; }\n\nbutton { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; padding: 0; }\ninput { font-family: inherit; }\n\n/* Header intro area outside the device */\n.intro {\n  max-width: 1200px;\n  margin: 0 auto 20px;\n  padding: 40px 28px 0;\n  color: #d4d8e2;\n}\n.intro h1 {\n  font-size: 22px; font-weight: 600; margin: 0 0 6px;\n  letter-spacing: -0.01em;\n}\n.intro p {\n  font-size: 13px; color: #8a92a1; margin: 0;\n  max-width: 640px; line-height: 1.5;\n}\n\n/* Tweaks panel */\n.tweaks {\n  position: fixed;\n  bottom: 24px;\n  right: 24px;\n  background: #0f1218;\n  border: 1px solid #2a2e38;\n  border-radius: 14px;\n  padding: 14px;\n  min-width: 240px;\n  box-shadow: 0 20px 60px rgba(0,0,0,0.5);\n  color: #d4d8e2;\n  font-size: 13px;\n  z-index: 100;\n  display: none;\n}\n.tweaks.on { display: block; }\n.tweaks h4 {\n  font-size: 10px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: #6b7385;\n  margin: 0 0 10px;\n  font-weight: 500;\n}\n.tweaks .seg {\n  display: flex;\n  background: #1a1d24;\n  border-radius: 8px;\n  padding: 3px;\n  gap: 2px;\n}\n.tweaks .seg button {\n  flex: 1;\n  padding: 7px 10px;\n  font-size: 12px;\n  border-radius: 6px;\n  color: #8a92a1;\n  font-weight: 500;\n}\n.tweaks .seg button.sel {\n  background: #2a2e38;\n  color: #eef1f6;\n}\n.tweaks .row { margin-bottom: 12px; }\n.tweaks .row:last-child { margin-bottom: 0; }\n\n/* Utility for touch targets — 64dp settings rows */\n.row-64 { min-height: 64px; }\n\n@keyframes pulse-dot {\n  0%, 100% { opacity: 1; }\n  50% { opacity: 0.3; }\n}\n.pulse-dot { animation: pulse-dot 1.8s ease-in-out infinite; }\n\n@keyframes sweep {\n  0% { transform: translateX(-100%); }\n  100% { transform: translateX(100%); }\n}\n<\u002Fstyle>\n  <script src=\"c6bee03d-2ef2-4a5b-8593-4d76e11f3198\" integrity=\"sha384-hD6/rw4ppMLGNu3tX5cjIb+uRZ7UkRJ6BPkLpg4hAu/6onKUg4lLsHAs9EBPT82L\" crossorigin=\"anonymous\"><\u002Fscript>\n  <script src=\"41e97cfc-eebd-4849-b314-aa0c00b6b837\" integrity=\"sha384-u6aeetuaXnQ38mYT8rp6sbXaQe3NL9t+IBXmnYxwkUI2Hw4bsp2Wvmx4yRQF1uAm\" crossorigin=\"anonymous\"><\u002Fscript>\n  <script src=\"9fed2e9e-22ac-47e2-8551-4653c1fb576d\" integrity=\"sha384-m08KidiNqLdpJqLq95G/LEi8Qvjl/xUYll3QILypMoQ65QorJ9Lvtp2RXYGBFj1y\" crossorigin=\"anonymous\"><\u002Fscript>\n  <style>\n    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }\n    @keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }\n    @keyframes slideInR { from { transform: translateX(24px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }\n    .stage { align-items: flex-start; }\n    .annot { max-width: 320px; color: #d4d8e2; font-family: 'Space Grotesk', sans-serif; padding-top: 40px; }\n    .annot .k { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.14em; color: #816a78; text-transform: uppercase; }\n    .annot h2 { font-size: 21px; font-weight: 600; margin: 4px 0 8px; }\n    .annot p { font-size: 13px; color: #a4889a; line-height: 1.55; margin: 0 0 14px; }\n    .annot ol { margin: 0; padding-left: 18px; }\n    .annot ol li { font-size: 12.5px; line-height: 1.5; padding: 5px 0; color: #cdd2dc; }\n    .annot ol li b { color: #fff; }\n    .flow-tag { display: inline-flex; align-items: center; gap: 6px; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.1em; color: #FF5582; border: 1px solid #FF5582; border-radius: 5px; padding: 3px 8px; margin-bottom: 12px; }\n  <\u002Fstyle>\n<\u002Fhead>\n<body>\n  \n  <div class=\"stage\" id=\"stage\"><\u002Fdiv>\n\n  <script>window.__TWEAKS = { theme: 'dark', palette: 'magenta', language: 'en' };<\u002Fscript>\n  <script type=\"text/babel\" src=\"8f863ac5-63cf-4d90-90b8-75ed9825db29\"><\u002Fscript>\n  <script type=\"text/babel\" src=\"7ed73883-f87b-49d4-9db2-fef98b5f347c\"><\u002Fscript>\n  <script type=\"text/babel\" src=\"4a218b53-0ce3-47b9-9a4f-51489b8b6df9\"><\u002Fscript>\n  <script type=\"text/babel\" src=\"989b55c9-4fa2-4a13-9c94-177d5712991d\"><\u002Fscript>\n  <script type=\"text/babel\" src=\"f06d5b42-be61-4dd2-b890-ee90ba5da8db\"><\u002Fscript>\n  <script type=\"text/babel\" src=\"7569a109-c7a0-442a-88e2-4cf4da359e6a\"><\u002Fscript>\n  <script type=\"text/babel\">\n    const { useState } = React;\n\n    function Demo() {\n      const [screen, setScreen] = useState('details'); // 'details' | 'edit'\n      const [saved, setSaved] = useState(false);\n\n      return (\n        <>\n          <div className=\"annot\">\n            <div className=\"flow-tag\">● TRIPS › TRIP DETAILS › EDIT<\u002Fdiv>\n            <div className=\"k\">Two-screen flow<\u002Fdiv>\n            <h2>Trip details → Edit trip<\u002Fh2>\n            <p>The captured trip opens as a read-only <b>Trip details<\u002Fb> page (locked GPS evidence). Tapping <b>Edit trip<\u002Fb> pushes the editable <b>Edit trip<\u002Fb> form.<\u002Fp>\n            <div className=\"k\" style={{marginTop: 18}}>How it works<\u002Fdiv>\n            <ol>\n              <li>From <b>Trips<\u002Fb>, tapping any logged trip opens <b>Trip details<\u002Fb> — route map, timeline, stats, and a read-only classification summary.<\u002Fli>\n              <li>The route is GPS-verified and <b>locked<\u002Fb> — it's the audit evidence, so it can't be altered.<\u002Fli>\n              <li>Tap the sticky <b>Edit trip<\u002Fb> button at the bottom.<\u002Fli>\n              <li>The <b>Edit trip<\u002Fb> form opens: change Business/Personal, odometer, company, notes.<\u002Fli>\n              <li>Odometer is guarded — Start can't fall below the vehicle's last reading; <b>Save<\u002Fb> stays disabled until valid.<\u002Fli>\n              <li><b>Save<\u002Fb> writes the changes and returns to Trip details; <b>Cancel<\u002Fb>/back discards.<\u002Fli>\n            <\u002Fol>\n            <div style={{ marginTop: 18, display: 'flex', gap: 8 }}>\n              <button onClick={() => { setScreen('details'); }} style={{\n                flex: 1, padding: '10px', borderRadius: 9, fontSize: 12, fontWeight: 600,\n                background: screen === 'details' ? '#FF5582' : '#1f1018', color: screen === 'details' ? '#15080e' : '#a4889a',\n                border: '1px solid ' + (screen === 'details' ? '#FF5582' : '#2e1a25'), cursor: 'pointer',\n              }}>1 · Details<\u002Fbutton>\n              <button onClick={() => { setScreen('edit'); }} style={{\n                flex: 1, padding: '10px', borderRadius: 9, fontSize: 12, fontWeight: 600,\n                background: screen === 'edit' ? '#FF5582' : '#1f1018', color: screen === 'edit' ? '#15080e' : '#a4889a',\n                border: '1px solid ' + (screen === 'edit' ? '#FF5582' : '#2e1a25'), cursor: 'pointer',\n              }}>2 · Edit<\u002Fbutton>\n            <\u002Fdiv>\n            {saved && <div style={{ marginTop: 12, fontSize: 12, color: '#6ee7a8' }}>✓ Saved — returned to Trip details<\u002Fdiv>}\n          <\u002Fdiv>\n\n          <div className=\"device-wrap\">\n            <div className=\"stage-label\">{screen === 'details' ? 'TRIP DETAILS · READ-ONLY' : 'EDIT TRIP · FORM'}<\u002Fdiv>\n            <AndroidDevice dark={true} width={380} height={800}>\n              <div data-theme=\"dark\" data-palette=\"magenta\" className=\"screen\" style={{ background: 'var(--bg)', height: '100%' }}>\n                <div key={screen} style={{ height: '100%', animation: 'slideInR .22s ease-out' }}>\n                  {screen === 'details'\n                    ? <TripDetails lang=\"en\" onBack={() => {}} onEdit={() => { setScreen('edit'); setSaved(false); }}/>\n                    : <EditTrip lang=\"en\" onBack={() => setScreen('details')} onSave={() => { setScreen('details'); setSaved(true); }}/>\n                  }\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002FAndroidDevice>\n          <\u002Fdiv>\n        <\u002F>\n      );\n    }\n    ReactDOM.createRoot(document.getElementById('stage')).render(<Demo/>);\n  <\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
