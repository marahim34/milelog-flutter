<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Required on Android 10+ for GPS to keep running when the app is in the
         background (e.g. screen off during a tracked trip). Declared separately
         from ACCESS_FINE_LOCATION so Android shows the dedicated "Allow all the
         time" dialog — see permission_onboarding_screen.dart step 0. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>

    <!-- Background tracking: keeps the process alive (via a foreground
         service) so GPS collection survives the screen locking or the app
         being minimized. FOREGROUND_SERVICE/RECEIVE_BOOT_COMPLETED/WAKE_LOCK
         and the service/receiver declarations themselves come from the
         flutter_background_service plugin's own manifest and are merged in
         automatically — only the location-type and notification permissions
         need declaring here. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Classic Bluetooth: bonded-device lookup + ACL connect/disconnect
         observation for vehicle auto-tracking. BLUETOOTH/BLUETOOTH_ADMIN
         cover Android <=11; BLUETOOTH_CONNECT is the Android 12+ runtime
         permission (requested at runtime via permission_handler). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>

    <!-- Lets BluetoothAclReceiver's BOOT_COMPLETED registration actually be
         delivered after a reboot, before the app has been launched once —
         see BluetoothAclReceiver.kt's class doc. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Prevents CPU from sleeping while GPS is actively collecting points. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Allows the app to ask Android to exempt it from battery optimization
         so GPS tracking continues when the screen is off or the app is
         in the background. Without this, the OS can suspend GPS. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <application
        android:label="MileLog"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true">
        <service
            android:name="id.flutter.flutter_background_service.BackgroundService"
            android:foregroundServiceType="location"
            android:stopWithTask="false"/>

        <!-- Native GPS foreground service — runs independently of the Flutter
             engine so tracking continues when the user swipes the app away.
             stopWithTask="false" keeps it alive across task removal. -->
        <service
            android:name=".TrackingService"
            android:foregroundServiceType="location"
            android:stopWithTask="false"
            android:exported="false"/>

        <!-- Static receiver that handles Bluetooth ACL events for ALL app states
             (alive, backgrounded, or fully killed). Replaces the "one-shot"
             BluetoothAclReceiver pattern that broke on Android 12+ because
             AppRouter.push() is blocked when the app is backgrounded.
             android:permission restricts delivery to the Bluetooth stack only.
             See BluetoothAutoStartReceiver.kt. -->
        <receiver
            android:name=".BluetoothAutoStartReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BLUETOOTH_CONNECT">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED"/>
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED"/>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
